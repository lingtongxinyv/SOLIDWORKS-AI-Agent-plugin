<Window x:Class="SwAiAssistant.AddIn.UI.DocChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手 · 选择目标文档" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="在当前零件继续" Padding="12,5" Margin="0,0,8,0"
                    IsDefault="True" Click="ContinueClick"/>
            <Button Content="新建零件" Padding="12,5" Margin="0,0,8,0"
                    Click="NewClick"/>
            <Button Content="取消" Padding="12,5" IsCancel="True" Click="CancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
