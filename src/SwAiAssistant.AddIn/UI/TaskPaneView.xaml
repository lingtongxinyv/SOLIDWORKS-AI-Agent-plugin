<UserControl x:Class="SwAiAssistant.AddIn.UI.TaskPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280" MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题条 -->
        <Border Grid.Row="0" Background="#FF1F6FB2" Padding="10,8">
                <TextBlock Text="SwAiAssistant · AI 建模助手"
                           Foreground="White" FontSize="13" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" x:Name="RootTabs" TabStripPlacement="Top" Margin="0"
                    SelectionChanged="RootTabs_SelectionChanged">

            <!-- 对话区 -->
            <TabItem Header="对话" x:Name="ChatTab">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="FastModeBox" Content="极速模式" VerticalAlignment="Center"
                                  ToolTip="勾选后 AI 计划不经确认直接执行" Checked="FastModeChanged" Unchecked="FastModeChanged"/>
                        <Button Content="清空对话" Padding="8,2" Margin="10,0,0,0" Click="ClearChatClick"/>
                        <Button Content="取消" x:Name="CancelChatButton" Padding="8,2" Margin="6,0,0,0"
                                IsEnabled="False" Click="CancelChatClick"/>
                        <Button Content="生成工程图" x:Name="DrawingButton" Padding="8,2" Margin="6,0,0,0"
                                Click="GenerateDrawingClick"
                                ToolTip="为当前零件一键生成 GB 第一角三视图工程图（自动插尺寸并导出 PDF）"/>
                        <Button Content="导入DXF" x:Name="ImportDxfButton" Padding="8,2" Margin="6,0,0,0"
                                Click="ImportDxfClick"
                                ToolTip="实验功能：识别 DXF 平板图纸生成候选建模计划，逐项核对后手动点「执行」（DWG 需先另存为 DXF）"/>
                        <Button Content="导入图片" x:Name="ImportImageButton" Padding="8,2" Margin="6,0,0,0"
                                Click="ImportImageClick"
                                ToolTip="实验功能：识别图纸照片/截图/PDF 首页（JPG/PNG/PDF）生成候选建模计划，逐项核对后手动点「执行」"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel">
                            <Border Background="#FFF2F7FC" BorderBrush="#FFBBD7EE" CornerRadius="4"
                                    Padding="8" Margin="0,4">
                                <TextBlock TextWrapping="Wrap" Foreground="#FF1F6FB2"
                                           Text="用自然语言描述要建的零件，例如：&#10;120×80×10 的安装板，四角 φ6 通孔，四边 C2 倒角&#10;&#10;也可以问：这个零件多重？包围盒多大？"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Grid.Column="0" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="40" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" Padding="6"
                                 KeyDown="ChatInputKeyDown"/>
                        <Button x:Name="SendButton" Grid.Column="1" Content="发送" Width="56"
                                Margin="6,0,0,0" Click="SendClick"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 计划卡片 -->
            <TabItem Header="计划" x:Name="PlanTab">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="PlanHeader" TextWrapping="Wrap"
                               Foreground="#FF555555" Text="暂无计划。在对话页描述零件后，AI 会把建模步骤列在这里。"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PlanStepsPanel"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="ExecutePlanButton" Content="执行" Width="80" Padding="0,5"
                                IsEnabled="False" Click="ExecutePlanClick"/>
                        <Button x:Name="CancelPlanButton" Content="取消计划" Width="80" Margin="8,0,0,0"
                                Padding="0,5" IsEnabled="False" Click="CancelPlanClick"/>
                        <TextBlock x:Name="PlanHint" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="#FF888888" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="材料" x:Name="MaterialTab">
                <StackPanel Margin="10">
                    <TextBlock Text="GB 常用材料库" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#FF666666" FontSize="11" Margin="0,0,0,8"
                               Text="建模计划中的材料（如「铝板」「不锈钢」）会自动猜测并在执行时赋值；也可在这里手动给当前零件指定材料，质量按材料密度重算。"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="ApplyMaterialButton" Content="应用到当前零件" Width="110"
                                DockPanel.Dock="Right" Padding="0,5" Click="ApplyMaterialClick"/>
                        <ComboBox x:Name="MaterialCombo" Margin="0,0,8,0" Padding="0,3"/>
                    </DockPanel>
                    <Button x:Name="RefreshMaterialButton" Content="刷新当前材料/质量" Width="140"
                            HorizontalAlignment="Left" Padding="0,4" Click="RefreshMaterialClick"/>
                    <TextBlock x:Name="MaterialCurrentText" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="#FF333333" Text="当前零件：未读取（打开零件后点「刷新」）。"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="快照" x:Name="SnapshotTab">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="刷新" Padding="10,2" Click="SnapshotRefreshClick"/>
                        <TextBlock x:Name="SnapshotDocLabel" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#FF777777" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="SnapshotListBox" MinHeight="120"
                             SelectionChanged="SnapshotListSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DisplayDetail}" FontSize="11"
                                               Foreground="#FF777777" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" x:Name="RollbackButton" Content="回滚到选中快照"
                            Padding="0,5" Margin="0,6,0,2" IsEnabled="False" Click="RollbackClick"/>

                    <TextBlock Grid.Row="3" x:Name="SnapshotResult" TextWrapping="Wrap" FontSize="11"
                               Foreground="#FF555555" MaxHeight="120"/>
                </Grid>
            </TabItem>

            <!-- 设置 -->
            <TabItem Header="设置" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" Text="全局设置"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="请求超时(秒)：" VerticalAlignment="Center"/>
                            <TextBox x:Name="TimeoutBox" Width="50" Padding="4,2"/>
                            <TextBlock Text="　校验阈值(%)：" VerticalAlignment="Center"/>
                            <TextBox x:Name="ThresholdBox" Width="50" Padding="4,2"/>
                            <Button Content="保存" Padding="10,2" Margin="10,0,0,0" Click="SaveGlobalsClick"/>
                        </StackPanel>

                        <Separator Margin="0,10"/>
                        <TextBlock FontWeight="Bold" Text="模型列表"/>
                        <ListBox x:Name="ModelListBox" Margin="0,6" MinHeight="90" MaxHeight="220"
                                 SelectionChanged="ModelListSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DisplayDetail}" FontSize="11" Foreground="#FF777777"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel>
                            <Button Content="添加" Padding="10,3" Margin="0,4,6,4" Click="AddModelClick"/>
                            <Button Content="编辑" Padding="10,3" Margin="0,4,6,4" Click="EditModelClick"/>
                            <Button Content="删除" Padding="10,3" Margin="0,4,6,4" Click="RemoveModelClick"/>
                            <Button Content="连通测试" Padding="10,3" Margin="0,4,6,4" Click="TestModelClick"/>
                            <Button Content="探测能力" Padding="10,3" Margin="0,4,6,4" Click="ProbeModelClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="ModelActionResult" TextWrapping="Wrap" FontSize="11"
                                   Foreground="#FF2F6B3A" Text=""/>

                        <Separator Margin="0,10"/>
                        <TextBlock FontWeight="Bold" Text="本机 Ollama（离线隐私模式）"/>
                        <TextBlock x:Name="OllamaStatus" TextWrapping="Wrap" Margin="0,4"
                                   Foreground="#FF555555" Text="状态未知"/>
                        <WrapPanel>
                            <Button Content="刷新状态" Padding="10,3" Margin="0,4,6,4" Click="OllamaRefreshClick"/>
                            <Button Content="一键修复" Padding="10,3" Margin="0,4,6,4" Click="OllamaRepairClick"/>
                            <Button Content="拉取推荐模型" Padding="10,3" Margin="0,4,6,4" Click="OllamaPullClick"/>
                            <Button x:Name="OllamaCancelPullButton" Content="取消拉取" Padding="10,3"
                                    Margin="0,4,6,4" IsEnabled="False" Click="OllamaCancelPullClick"/>
                        </WrapPanel>
                        <ProgressBar x:Name="OllamaPullProgress" Height="10" Margin="0,2"
                                     Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                        <TextBlock x:Name="OllamaPullText" FontSize="11" Foreground="#FF777777"
                                   TextWrapping="Wrap"/>

                        <Separator Margin="0,10"/>
                        <TextBlock FontWeight="Bold" Text="关于"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#FF555555" Margin="0,4,0,0"
                                   Text="版本 0.2.0（M2）：自然语言建模、对话修改与数据问答、GB 材料、强校验闭环、快照回滚、DXF/图片反建（实验）&#10;已知限制：草图约束/标注不自动施加，螺纹孔按光孔创建，筋板为实验能力（详见随附 release-notes）&#10;配置与日志位于 %AppData%\SwAiAssistant\"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 运行日志页 -->
            <TabItem Header="日志" x:Name="LogTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="刷新" Padding="10,3" Margin="0,6,0,0" Click="LogRefreshClick"/>
                        <Button Content="打开日志目录" Padding="10,3" Margin="0,6,0,0" Click="LogOpenFolderClick"/>
                        <Button Content="导出日志 ZIP…" Padding="10,3" Margin="0,6,0,0" Click="LogExportClick"/>
                    </StackPanel>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                             AcceptsReturn="True" Background="#FFFAFAFA"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#FFEFEFEF" Padding="10,4">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="#FF666666" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
